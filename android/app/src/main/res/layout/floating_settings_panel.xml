<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_settings_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_panel"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="浮窗设置"
            android:textColor="#3D2B1F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_close_settings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_save_button"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="完成"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab 切换栏（底部指示器样式） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tab_appearance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="外观"
                android:textColor="#1A1A1A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/tab_indicator_appearance"
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_gravity="center|bottom"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_tab_indicator" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tab_function"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="功能"
                android:textColor="#999999"
                android:textSize="15sp" />

            <View
                android:id="@+id/tab_indicator_function"
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_gravity="center|bottom"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_tab_indicator"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0" />

    <!-- ===== 外观设置页（默认显示） ===== -->
    <LinearLayout
        android:id="@+id/page_appearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 颜色选择 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="按钮颜色"
            android:textColor="#666666"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/color_red"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_color_circle"
                android:backgroundTint="#FF6B6B"
                android:elevation="2dp" />

            <View
                android:id="@+id/color_purple"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_color_circle"
                android:backgroundTint="#7C4DFF"
                android:elevation="2dp" />

            <View
                android:id="@+id/color_blue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_color_circle"
                android:backgroundTint="#448AFF"
                android:elevation="2dp" />

            <View
                android:id="@+id/color_green"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_color_circle"
                android:backgroundTint="#66BB6A"
                android:elevation="2dp" />

            <View
                android:id="@+id/color_orange"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_color_circle"
                android:backgroundTint="#FFA726"
                android:elevation="2dp" />

            <View
                android:id="@+id/color_pink"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_color_circle"
                android:backgroundTint="#EC407A"
                android:elevation="2dp" />
        </LinearLayout>

        <!-- 按钮图标 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="按钮图标"
            android:textColor="#666666"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/icon_default"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_option"
                    android:gravity="center"
                    android:text="✏️"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/icon_bulb"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_option"
                    android:gravity="center"
                    android:text="💡"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/icon_note"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_option"
                    android:gravity="center"
                    android:text="📝"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/icon_pin"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_option"
                    android:gravity="center"
                    android:text="📌"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/icon_bell"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_option"
                    android:gravity="center"
                    android:text="🔔"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/icon_star"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_option"
                    android:gravity="center"
                    android:text="⭐"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/icon_moon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_option"
                    android:gravity="center"
                    android:text="🌙"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/icon_sun"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_option"
                    android:gravity="center"
                    android:text="☀️"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/icon_flower"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_option"
                    android:gravity="center"
                    android:text="🌸"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/icon_fire"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_option"
                    android:gravity="center"
                    android:text="🔥"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/icon_diamond"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_option"
                    android:gravity="center"
                    android:text="💎"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/icon_target"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_option"
                    android:gravity="center"
                    android:text="🎯"
                    android:textSize="22sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 透明度 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="按钮透明度"
            android:textColor="#666666"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/seekbar_opacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="100" />

            <TextView
                android:id="@+id/tv_opacity_value"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="100%"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 按钮大小 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="按钮大小"
            android:textColor="#666666"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_size_small"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_size_option"
                android:gravity="center"
                android:text="小"
                android:textColor="#666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_size_medium"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_size_option_selected"
                android:gravity="center"
                android:text="中"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_size_large"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_size_option"
                android:gravity="center"
                android:text="大"
                android:textColor="#666666"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 功能设置页（默认隐藏） ===== -->
    <LinearLayout
        android:id="@+id/page_function"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 使用标签 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="使用标签"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_use_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 同步到通知 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="保存后同步到通知"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_sync_notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 同步到自言自语 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="保存后同步到自言自语"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_sync_self_talk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 字数统计显示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="显示字数统计"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_show_word_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 靠边自动隐藏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="拖动贴边后自动缩小"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_auto_hide_edge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 字体大小 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="字体大小"
            android:textColor="#666666"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textColor="#999999"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekbar_font_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="12"
                android:min="0"
                android:progress="3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24"
                android:textColor="#999999"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_font_size_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="15sp"
            android:textColor="#1A1A1A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 双击灵敏度 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="双击灵敏度"
            android:textColor="#666666"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="快"
                android:textColor="#999999"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekbar_double_tap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="700"
                android:min="100"
                android:progress="200" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="慢"
                android:textColor="#999999"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_double_tap_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="300ms"
            android:textColor="#1A1A1A"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 操作提示 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="双击浮窗展开面板 · 长按打开应用 · 拖动贴边自动缩小"
        android:textColor="#AAAAAA"
        android:textSize="12sp" />
</LinearLayout>
