<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 面板内容 -->
    <LinearLayout
        android:id="@+id/floating_panel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_panel"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 顶部工具栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="速记"
                android:textColor="#1A1A1A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_panel_action"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="设置"
                android:textColor="#666666"
                android:textSize="13sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/btn_paste"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_panel_action"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="粘贴"
                android:textColor="#FF6B6B"
                android:textSize="13sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/btn_close_panel"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_panel_action"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="关闭"
                android:textColor="#999999"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 输入框 -->
        <EditText
            android:id="@+id/et_quick_note"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_edit_text"
            android:gravity="top|start"
            android:hint="写下此刻的想法..."
            android:imeOptions="flagNoExtractUi"
            android:inputType="textMultiLine|textCapSentences"
            android:lineSpacingMultiplier="1.3"
            android:padding="14dp"
            android:textColor="#1A1A1A"
            android:textSize="15sp" />

        <!-- 底部工具栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinner_tag"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <TextView
                android:id="@+id/tv_word_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="0字"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_save_button"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="保存"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 拖动横杠（右下角） -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_drag_handle" />
</FrameLayout>
