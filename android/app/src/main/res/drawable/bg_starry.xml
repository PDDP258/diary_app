<?xml version="1.0" encoding="utf-8"?>
<!-- 
    星空主题背景
    基于设计规范：135°线性渐变
    0%: #0d0d12 -> 45%: #18161c -> 80%: #2d1f24 -> 100%: #4a2c32
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#0d0d12"
        android:centerColor="#18161c"
        android:centerX="0.45"
        android:endColor="#5a2c32"
        android:gradientRadius="108" />
</shape>
