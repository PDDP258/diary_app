<?xml version="1.0" encoding="utf-8"?><!-- 颜色选中圆圈：白色外圈 + 内间距 --><layer-list xmlns:android="http://schemas.android.com/apk/res/android">    <!-- 白色外圈（选中指示） -->    <item>        <shape android:shape="oval">            <solid android:color="#00000000" />            <stroke android:width="3dp" android:color="#FFFFFF" />            <size android:width="36dp" android:height="36dp" />        </shape>    </item>    <!-- 内圈（颜色由 backgroundTint 动态设置） -->    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">        <shape android:shape="oval">            <solid android:color="#FF6B6B" />        </shape>    </item></layer-list>