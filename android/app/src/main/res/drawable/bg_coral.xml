<?xml version="1.0" encoding="utf-8"?>
<!-- 
    珊瑚红主题背景 - 渐变
    角度：135°（从左上到右下）
    色标：深珊瑚红 -> 浅珊瑚红
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#E85A5A"
        android:centerColor="#FF6B6B"
        android:centerX="0.5"
        android:endColor="#FF8E8E"
        android:gradientRadius="108" />
</shape>
