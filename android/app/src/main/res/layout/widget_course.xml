<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课程小组件（自绘 RemoteViews，见 CourseWidgetRenderer.kt）

     ⚠️⚠️ 这个布局里的**每个标签**都必须落在 RemoteViews 白名单内，否则会在
     **启动器进程**里 inflate 失败，桌面直接显示「无法加载小部件」——
     而这条异常 App 侧完全看不到（onUpdate 的 try/catch 拦不住，是对方进程在炸）。
     白名单（框架 `RemoteViews.INFLATER_FILTER` 用
     `clazz.isAnnotationPresent(@RemoteView.class)` 强校验）：
       容器：FrameLayout / LinearLayout / RelativeLayout / GridLayout
       控件：AnalogClock / Button / Chronometer / ImageButton / ImageView /
             ProgressBar / TextView / ViewFlipper / ListView / GridView /
             StackView / AdapterViewFlipper / ViewStub
     **`<View>` 不在白名单里**（`android.view.View` 没有 @RemoteView）—— 别拿它当
     分隔线，用 1dp 高的 ImageView / TextView 代替。回归测试见
     test/course_widget_layout_test.dart。

     背景用 ImageView 图层而不是根布局的 android:background：
     一是切换深浅色只需 setImageViewResource（走官方 API，不碰反射，
     也就不会撞上 `@RemotableViewMethod` 运行时校验），二是圆角不受拉伸影响。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 底板图层：浅色/深色由渲染器 setImageViewResource 切换 -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_course_bg_light"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- ==================== 头部：日期块 + 标题 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="50dp">

                <!-- 圆角色块：颜色由渲染器用 setImageViewBitmap 画出来，
                     这样既能圆角又能跟随主题/课程色板 -->
                <ImageView
                    android:id="@+id/widget_chip_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/widget_chip_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:textColor="#FFFFFF"
                        android:text="1" />

                    <TextView
                        android:id="@+id/widget_chip_weekday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="10sp"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.06"
                        android:textColor="#FFFFFF"
                        android:text="周一" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#2C241F"
                    android:text="今日课程" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="11sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#8A7D6F"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 分割线 ====================
             注意：这里**必须**是 ImageView/TextView 这类白名单控件，
             不能用 <View>（见文件头说明）。颜色由渲染器 setBackgroundColor 设置。 -->
        <ImageView
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:background="#F5E6D3"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <!-- ==================== 课程列表（行由渲染器动态 addView） ==================== -->
        <LinearLayout
            android:id="@+id/widget_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <!-- ==================== 无课 / 未同步 ==================== -->
        <LinearLayout
            android:id="@+id/widget_empty_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:includeFontPadding="false"
                android:textColor="#2C241F"
                android:text="今日无课" />

            <TextView
                android:id="@+id/widget_empty_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:textColor="#8A7D6F"
                android:text="" />
        </LinearLayout>

        <!-- ==================== 底部提示（还有 N 节 / 今日已上完） ==================== -->
        <TextView
            android:id="@+id/widget_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textSize="10.5sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#8A7D6F"
            android:visibility="gone"
            android:text="" />
    </LinearLayout>
</FrameLayout>
